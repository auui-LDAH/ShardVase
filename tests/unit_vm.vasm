; ============================================================================
; tests/unit_vm.vasm — VM 指令集单测 (ROADMAP Phase 1d / A4 扩充)
;
; 逐个验证新增指令: nop / lea / pushr / popr / setcon / pushcon / callind
; (Phase 1d) + move / loadr32 / storr32 / brk-通过路径 (A4)。
; 运行结论写入宿主内存 (由 tests/vm_unit.c 断言):
;   host[0x1000] = 0x1BAD2F5E   (nop + pushr/popr)
;   host[0x1004] = 0x101        (setcon + pushcon)
;   host[0x2000] = 0xC0F0       (lea + callind 间接调用子程序)
;   host[0x302C] = 0xCAFEBABE   (move + storr32 寄存器索引写)
;   host[0x3030] = 0xCAFEBABE   (loadr32 寄存器索引读)
;   host[0]     = 0x2A2A       (整体成功标记; brk CON=0 通过路径)
; 汇编器: tools/vmenc.py (use '-labs' 支持 lea)。
; brk 陷阱路径 (CON=1) 单独见 tests/unit_vm_brk.vasm。
; ============================================================================

    ; ---------- Phase A: nop / pushr / popr ----------
    push32 0x1BAD2F5E
    popr                 ; R = 0x1BAD2F5E
    nop                  ; 空转
    pushr                ; [0x1BAD2F5E]
    push32 0x1000
    setbase              ; BR = 0x1000
    pushbase             ; [0x1BAD2F5E 0x1000]
    swap                 ; [0x1000 0x1BAD2F5E]
    store32              ; host[0x1000] = 0x1BAD2F5E

    pushbase
    push32 4
    add
    setbase              ; BR = 0x1004

    ; ---------- Phase B: setcon / pushcon ----------
    push32 0
    setcon               ; CON = 0 (值取零)
    pushcon              ; [0]
    push32 0xFF
    setcon               ; CON = 1 (值非零)
    pushcon              ; [0 1]
    add                  ; = 1
    push32 0x101
    mul                  ; = 0x101
    pushbase             ; [0x101 0x1004]
    swap
    store32              ; host[0x1004] = 0x101

    ; ---------- Phase C: lea + callind 间接调用 ----------
    lea  sub_r
    callind              ; 压入返回地址, 跳转 sub_r
    jmp  done

sub_r:
    push32 0xC0F0
    push32 0x2000
    setbase
    pushbase
    swap
    store32              ; host[0x2000] = 0xC0F0
    ret                  ; pop 返回地址

    ; ---------- Phase D (A4): move / loadr32 / storr32 / brk-通过 ----------
    move 0x28            ; R = 0x28 (索引寄存器)
    push32 0x3000
    setbase              ; BR = 0x3000
    push32 0xCAFEBABE
    push32 4             ; [val off]
    storr32              ; host[BR + R + off] = host[0x302C] = 0xCAFEBABE
    push32 4
    loadr32              ; [host[0x302C]] = 0xCAFEBABE
    push32 0x3030
    swap
    store32              ; host[0x3030] = loadr32 读取结果
    push32 0
    setcon               ; CON = 0
    brk                  ; 断言通过 -> 继续执行

done:
    nop
    push32 0
    push32 0x2A2A        ; [addr=0 val=0x2A2A]
    store32              ; host[0] = 0x2A2A
    halt