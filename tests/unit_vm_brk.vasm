; ============================================================================
; tests/unit_vm_brk.vasm — brk 断言陷阱路径单测 (A4)
;
; CON=1 时 brk 必须停机并返回 PROT_ERR_VM_BREAKPOINT;
; 陷阱后的指令 (写 host[0] 成功标记) 不得执行。
; 由 tests/vm_unit.c 运行 g_vm_unit_brk_image 断言状态码与内存。
; ============================================================================

    push32 1
    setcon               ; CON = 1 (断言失败)
    brk                  ; 陷阱 -> 停机 (不应继续)
    push32 0x2A2A
    push32 0
    store32              ; 若执行到, 说明 brk 未拦截
    halt
