#include <winres.h>
#include "protect/version.h"

/* 版本资源 (RELEASE §2.3) — 值只从 version.h 来, 不得二次硬编码 */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    PROT_VERSION_RC_NUM
 PRODUCTVERSION PROT_VERSION_RC_NUM
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "PROT"
            VALUE "FileDescription",  "Anti-Reverse Protection Demo"
            VALUE "FileVersion",      PROT_VERSION_STR
            VALUE "InternalName",     "demo"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "demo.exe"
            VALUE "ProductName",      "PROT Protection Suite"
            VALUE "ProductVersion",   PROT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
